#!/usr/bin/env bash
set -euo pipefail

APP_NAME="codex-proxy-rs"
VERSION_FILE="release/version.yaml"
NOTES_FILE="release/notes.md"
TAG_PREFIX="v"

usage() {
  cat <<USAGE
Usage:
  release/publish <version>
  release/publish --check <version>

Example:
  release/publish 0.1.4

Leave the target version's release/notes.md uncommitted, with "# v<version>"
as its first line. Other tracked files must be clean.
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

read_version_key() {
  local key="$1"
  ruby -ryaml -e '
    path, key = ARGV
    data = YAML.load_file(path)
    value = data[key] if data.is_a?(Hash)
    unless value.is_a?(String) && !value.strip.empty?
      warn "#{path}: #{key} must be a non-empty string"
      exit 1
    end
    puts value.strip
  ' "$VERSION_FILE" "$key"
}

update_version_file() {
  local version="$1"
  ruby - "$VERSION_FILE" "$version" <<'RUBY'
path, version = ARGV
content = File.read(path)

unless content.match?(/^version:/)
  warn "#{path}: missing version key"
  exit 1
end

content = content.sub(/^version:\s*.*$/, %(version: "#{version}"))
File.write(path, content)
RUBY
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

check_only=false
if [[ "${1:-}" == "--check" ]]; then
  check_only=true
  export GIT_OPTIONAL_LOCKS=0
  shift
fi

[[ "$#" -eq 1 ]] || {
  usage >&2
  exit 2
}

require_command git
require_command gh
require_command ruby

gh auth status >/dev/null 2>&1 || die "gh authentication is required; run gh auth login first"

version="$1"
metadata_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/release-metadata.rb"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repository"
cd "$repo_root"

git ls-files --error-unmatch "$VERSION_FILE" >/dev/null 2>&1 || die "$VERSION_FILE is not tracked"

branch="$(git symbolic-ref --quiet --short HEAD)" || die "publishing from detached HEAD is not supported"
remote="$(git config --get "branch.$branch.remote" || true)"
merge_ref="$(git config --get "branch.$branch.merge" || true)"
[[ -n "$remote" && -n "$merge_ref" ]] || die "current branch has no upstream"
remote_branch="${merge_ref#refs/heads/}"
[[ "$remote_branch" != "$merge_ref" && -n "$remote_branch" ]] || die "unsupported upstream ref: $merge_ref"
remote_url="$(git remote get-url "$remote")" || die "failed to resolve remote URL for $remote"
repository="$(gh repo view "$remote_url" --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null)" ||
  die "failed to resolve GitHub repository for $remote_url"

if ! git diff --quiet --ignore-submodules -- . ":(exclude)$NOTES_FILE"; then
  die "tracked files outside $NOTES_FILE have unstaged changes"
fi
if ! git diff --cached --quiet --ignore-submodules -- . ":(exclude)$NOTES_FILE"; then
  die "index has staged changes outside $NOTES_FILE"
fi

version="$(ruby "$metadata_script" validate "$version")"
ruby release/toolchains.rb >/dev/null
ruby -r ./release/release-metadata -e 'ReleaseMetadata.platforms'
current_version="$(read_version_key version)"
current_version="${current_version#v}"
[[ "$version" != "$current_version" ]] || die "$VERSION_FILE is already $version"

tag="${TAG_PREFIX}${version}"

git ls-files --error-unmatch "$NOTES_FILE" >/dev/null 2>&1 || die "$NOTES_FILE is not tracked"
if git diff HEAD --quiet -- "$NOTES_FILE"; then
  die "$NOTES_FILE must contain uncommitted release notes"
fi
if git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null; then
  die "local tag already exists: $tag"
fi

if [[ "$check_only" == false ]]; then
  git fetch "$remote"
fi

upstream="$remote/$remote_branch"
local_head="$(git rev-parse HEAD)"
remote_refs="$(git ls-remote --refs "$remote" "$merge_ref" "refs/tags/$tag")" || die "failed to read remote refs"
upstream_head="$(awk -v ref="$merge_ref" '$2 == ref { print $1 }' <<< "$remote_refs")"
[[ -n "$upstream_head" ]] || die "upstream branch does not exist: $upstream"
if awk -v ref="refs/tags/$tag" '$2 == ref { found = 1 } END { exit !found }' <<< "$remote_refs"; then
  die "remote tag already exists: $tag"
fi
git cat-file -e "$upstream_head^{commit}" 2>/dev/null || die "upstream has unseen commits; run git fetch $remote first"
merge_base="$(git merge-base HEAD "$upstream_head")" || die "branch has no common history with $upstream"

if [[ "$local_head" != "$upstream_head" && "$merge_base" != "$upstream_head" ]]; then
  if [[ "$merge_base" == "$local_head" ]]; then
    die "branch is behind $upstream; pull or rebase first"
  fi
  die "branch has diverged from $upstream"
fi

if [[ "$check_only" == true ]]; then
  echo "Preflight passed: $APP_NAME $version on $branch -> $repository ($remote_branch)"
  echo "No files, Git refs, or remote state changed."
  exit 0
fi

update_version_file "$version"

git add -- "$VERSION_FILE" "$NOTES_FILE"
git commit -m "chore(release): prepare $tag"

git tag -a "$tag" -m "$tag"
git push --atomic "$remote" "HEAD:$remote_branch" "refs/tags/$tag"

# Dispatch from the long-lived release branch instead of the tag so GitHub
# Actions caches remain reusable across releases.
if ! gh workflow run release.yml \
  --repo "$repository" \
  --ref "$remote_branch" \
  --raw-field "tag=$tag"; then
  echo "error: commit and tag were pushed, but the Release workflow was not dispatched" >&2
  echo "retry: gh workflow run release.yml --repo $repository --ref $remote_branch --raw-field tag=$tag" >&2
  exit 1
fi

cat <<DONE
Published $APP_NAME $version
Commit: $(git rev-parse --short HEAD)
Tag:    $tag
Release workflow dispatched from: $remote_branch
DONE
